<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="assets/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="assets/bootstrap/css/bootstrap-grid.min.css">
  <link rel="stylesheet" href="assets/bootstrap/css/bootstrap-reboot.min.css">
  <link rel="stylesheet" href="assets/parallax/jarallax.css">
  <link rel="stylesheet" href="assets/dropdown/css/style.css">
  <link rel="stylesheet" href="assets/socicon/css/styles.css">
  <link rel="stylesheet" href="assets/theme/css/style.css">
  <link rel="stylesheet" href="/css/servicos.css">
  <link rel="preload"
    href="https://fonts.googleapis.com/css?family=IBM+Plex+Sans:100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i&display=swap"
    as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript>
    <link rel="stylesheet"
      href="https://fonts.googleapis.com/css?family=IBM+Plex+Sans:100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i&display=swap">
  </noscript>
  <link rel="preload" as="style" href="assets/mobirise/css/mbr-additional.css?v=gsorjj">
  <link rel="stylesheet" href="assets/mobirise/css/mbr-additional.css?v=gsorjj" type="text/css">

</head>

<body>
  <header>
    <div class="navbar-brand">
      <span class="navbar-logo">
        <a href="/">
          <img src="assets/images/logo-4-121x121.png" alt="Mobirise" style="height: 4.1rem;">
        </a>
      </span>
    </div>
    <nav>
      <a href="/">Home</a>
      <a href="servicos">Serviços</a>
      <a href="login">Login</a>
      <a href="contato">Contato</a>
      <a href="carrinho">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-shopping-cart">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
      </a>
    </nav>
  </header>
  <main>
    <h1 class="text-center" style="margin-top: 10vh; color: var(--blue);">Escolha o serviço a ser contratado</h1>

    <section class="card-display">
      <% if(servicos && servicos.length > 0) { %>
        <% servicos.forEach(servico => { %>
          <div class="card" style="width: 18rem; border: 1px solid    #555555;">
            <div class="card-body">
              <h5 class="card-title"><%= servico.nome %></h5>
              <p class="card-text"> <%= servico.descricao %></p>
            </div>
            <ul class="list-group list-group-flush">
              <li class="list-group-item"></li>
              <li class="list-group-item">Preço: R$<%= servico.valor %></li>
              <li class="list-group-item">Estado: <% if (servico.disponivel == 1) { %>Disponível<% } else { %>Indisponível<% } %> </li>
            </ul>
            <div class="card-body">
              <a href="#" class="card-link comprar-btn" data-id="<%= servico.id %>">Comprar</a>
              <a href="carrinho" class="card-link">Adicionar Item <svg xmlns="http://www.w3.org/2000/svg" width="20"
                  height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round" class="feather feather-shopping-cart">
                  <circle cx="9" cy="21" r="1"></circle>
                  <circle cx="20" cy="21" r="1"></circle>
                  <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg></a>
            </div>
          </div>
        <% }); %>
    <% } else { %>
        <p>Nenhum serviço foi encontrado.</p>
    <% } %>
    </section>
  </main>

  <footer>
    <nav>
      <a href="sobre">Sobre Nós</a>
      <a href="servicos">Serviços</a>
      <a href="contato">Contato</a>
    </nav>
    <p>&copy; 2024 TechTweaks. Todos os direitos reservados.</p>
  </footer>

</body>

<script>
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.comprar-btn').forEach(function(button) {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            var servicoId = this.getAttribute('data-id');
            adicionarAoCarrinho(servicoId);
        });
    });
});

function adicionarAoCarrinho(servicoId) {
    let carrinho = JSON.parse(localStorage.getItem('carrinho')) || [];
    let itemIndex = carrinho.findIndex(item => item.servicoId === servicoId);

    if (itemIndex !== -1) {
        carrinho[itemIndex].quantidade += 1;
    } else {
        // Correção: use diretamente a variável servicoId ao invés de item.servicoId
        carrinho.push({ servicoId: servicoId, quantidade: 1 });
    }
    localStorage.setItem('carrinho', JSON.stringify(carrinho));
    alert('Serviço adicionado ao carrinho!');
}

</script>

</html>